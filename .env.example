# Shared root environment file. Copy to .env; never commit real secrets.
APP_NAME=FOOTLYTICS
ENVIRONMENT=development
API_PREFIX=/api
DATABASE_URL=sqlite:///./storage/footlytics.db
STORAGE_DIR=./storage
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Replace this placeholder with a random secret of at least 32 bytes.
# The API refuses to start with a missing, weak or placeholder secret.
JWT_SECRET=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Preparation, detection and tracking share this queue; no synchronous fallback.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=video-processing
REDIS_CONNECT_TIMEOUT_SECONDS=2
RQ_JOB_TIMEOUT_SECONDS=120
RQ_RESULT_TTL_SECONDS=86400

# Upload bytes (2 GiB), bounded metadata inspection and actual frame decoding.
MAX_UPLOAD_SIZE=2147483648
FFPROBE_PATH=ffprobe
VIDEO_INSPECTION_TIMEOUT_SECONDS=30

# Pretrained person detection; weights download on first worker use if missing.
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=640
DEVICE=auto
DETECTION_FRAME_STRIDE=1
# Enable only for a fixed camera; filtering also requires all four pitch corners.
DETECTION_ROI_ENABLED=true
# CPU inference on a long clip can take hours; separate from preparation timeout.
DETECTION_JOB_TIMEOUT_SECONDS=21600
# ByteTrack reads existing detection CSVs; TRACK_BUFFER counts source frames.
# Detection also stores boxes from TRACK_LOW_THRESH (> 0) up to YOLO_CONFIDENCE for
# tracking only; TRACK_HIGH_THRESH must be at least YOLO_CONFIDENCE.
# Tracking uses the same long-job timeout as detection.
TRACK_HIGH_THRESH=0.25
TRACK_LOW_THRESH=0.1
TRACK_MATCH_THRESH=0.8
TRACK_BUFFER=30
# Jersey evidence: interval in source frames; bounded samples per track.
TEAM_SAMPLE_INTERVAL=15
TEAM_MAX_SAMPLES_PER_TRACK=20
TEAM_MIN_SAMPLES=3
TEAM_MIN_CROP_WIDTH=8
TEAM_MIN_CROP_HEIGHT=8
TEAM_UNKNOWN_THRESHOLD=0.6
# Raw coordinates remain unchanged; these are quality filters, not player metrics.
TRAJECTORY_MAX_PLAUSIBLE_SPEED_MPS=12
TRAJECTORY_MAX_GAP_SECONDS=2
TRAJECTORY_SMOOTHING_WINDOW=3
TRAJECTORY_SMOOTHING_MAX_SHIFT_METRES=0.5
# Physical analytics use only the current usable cleaned trajectory observations.
PLAYER_SPRINT_SPEED_THRESHOLD_MPS=7.0
PLAYER_SPRINT_MIN_DURATION_SECONDS=1.0
PLAYER_HEATMAP_BINS_X=20
PLAYER_HEATMAP_BINS_Y=12
# Team shape uses usable cleaned positions; fewer players means unavailable geometry.
TACTICS_MIN_PLAYERS_PER_TEAM=3
DEFAULT_PROCESSING_PROFILE=balanced

# Only VITE_* values are exposed to the browser. Never put secrets here.
VITE_API_BASE_URL=/api
# Used by the Vite development proxy only, not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
